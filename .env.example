# PostgreSQL bağlantısı (docker-compose ile: postgres://kraftora:kraftora@localhost:5435/kraftora)
DATABASE_URL=postgres://kraftora:kraftora@localhost:5435/kraftora

# İlk admin kullanıcısı (db:seed ile oluşturulur)
SEED_ADMIN_EMAIL=admin@kraftorapack.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=degistir-beni

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
